import random
import time

from matplotlib import pyplot as plt

def merge_sort(a):
    n=len(a)
    if(n>1):
        b,c=a[0:n//2],a[n//2:n]
        merge_sort(b)
        merge_sort(c)
        merge(a,b,c)
      
def merge(a,b,c):
    n1,n2=len(b),len(c)
    i=j=k=0

    while(i < n1 and j < n2):
        if(b[i]<c[j]):
            a[k]=b[i];i+=1
        else:
            a[k]=c[j];j+=1
        k+=1

    while(i<n1):
        a[k]=b[i];i+=1;k+=1

    while(j<n2):
        a[k]=c[j];j+=1;k+=1


