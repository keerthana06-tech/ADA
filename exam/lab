 INF = 99999

def dijkstra(graph, source, n):
    visited = [False] * n
    dist = [INF] * n

    dist[source] = 0

    for _ in range(n):
        min_dist = INF
        u = -1

        for i in range(n):
            if not visited[i] and dist[i] < min_dist:
                min_dist = dist[i]
                u = i

        visited[u] = True

        for v in range(n):
            if (not visited[v] and graph[u][v] != INF 
                and dist[u] + graph[u][v] < dist[v]):
                dist[v] = dist[u] + graph[u][v]

    return dist

